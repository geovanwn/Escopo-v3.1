{
  "name": "escopov3",
  "private": true,
  "main": "dist-electron/main.cjs",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts",
    "build": "vite build && electron-builder",
    "build:installer": "node scripts/build_installer.js",
    "build:exe": "node scripts/build_installer.js",
    "preview": "vite preview",
    "test": "vitest",
    "proxy": "node --openssl-legacy-provider server/proxy-server.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.99.0",
    "axios": "^1.13.2",
    "chokidar": "^5.0.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.7.3",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "firebase": "^12.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.560.0",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.3",
    "nodemailer": "^7.0.13",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.10.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^2.2.3",
    "recharts": "^3.5.1",
    "tailwind-merge": "^2.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.2.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/html2canvas": "^0.5.35",
    "@types/jspdf": "^1.3.3",
    "@types/node-forge": "^1.3.14",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.31",
    "supabase": "^2.77.1",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.16"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.6.2"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "author": "Geovani Silva",
  "description": "EscopoV3 Desktop Application",
  "build": {
    "appId": "com.escopov3.app",
    "productName": "EscopoV3",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "forceCodeSigning": false
  }
}